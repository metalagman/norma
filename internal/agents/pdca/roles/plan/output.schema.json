{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanResponse",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string" },
        "expected_exit_codes": { "type": "array", "items": { "type": "integer" } }
      },
      "required": ["id", "command", "expected_exit_codes"]
    },
    "planned_acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } }
      },
      "required": ["id", "text", "checks"]
    },
    "do_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"]
    },
    "plan_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/planned_acceptance_criterion" }
        },
        "do_steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/do_step" }
        }
      },
      "required": ["acceptance_criteria", "do_steps"]
    }
  },
  "properties": {
    "status": { "type": "string", "enum": ["ok", "stop", "error"] },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "plan_output": { "$ref": "#/definitions/plan_output" }
  },
  "required": ["status", "summary", "plan_output"]
}
