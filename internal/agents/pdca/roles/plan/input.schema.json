{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanRequest",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "iteration": { "type": "integer" }
      },
      "required": ["id", "iteration"]
    },
    "baseline_acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "verify_hints": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "text", "verify_hints"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "goal": { "type": "string" },
        "acceptance_criteria": {
          "type": "array",
          "items": { "$ref": "#/definitions/baseline_acceptance_criterion" }
        }
      },
      "required": ["id", "goal", "acceptance_criteria"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" }
      },
      "required": ["index"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_dir": { "type": "string" }
      },
      "required": ["workspace_dir"]
    }
  },
  "properties": {
    "run": { "$ref": "#/definitions/run" },
    "task": { "$ref": "#/definitions/task" },
    "step": { "$ref": "#/definitions/step" },
    "paths": { "$ref": "#/definitions/paths" }
  },
  "required": ["run", "task", "step", "paths"]
}
