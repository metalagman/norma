{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckResponse",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "acceptance_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ac_id": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "notes": { "type": "string" }
      },
      "required": ["ac_id", "result", "notes"]
    },
    "check_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptance_results": {
          "type": "array",
          "items": { "$ref": "#/definitions/acceptance_result" }
        },
        "verdict": { "type": "string", "enum": ["pass", "fail"] }
      },
      "required": ["acceptance_results", "verdict"]
    }
  },
  "properties": {
    "status": { "type": "string", "enum": ["ok", "stop", "error"] },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "check_output": { "$ref": "#/definitions/check_output" }
  },
  "required": ["status", "summary", "check_output"]
}
