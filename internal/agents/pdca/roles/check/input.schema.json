{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckRequest",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "iteration": { "type": "integer" }
      },
      "required": ["id", "iteration"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "goal": { "type": "string" }
      },
      "required": ["id", "goal"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" }
      },
      "required": ["index"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_dir": { "type": "string" }
      },
      "required": ["workspace_dir"]
    },
    "do_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string" },
        "expected_exit_codes": { "type": "array", "items": { "type": "integer" } }
      },
      "required": ["id", "command", "expected_exit_codes"]
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } }
      },
      "required": ["id", "text", "checks"]
    },
    "check_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "do_steps": { "type": "array", "items": { "$ref": "#/definitions/do_step" } },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "#/definitions/acceptance_criterion" } },
        "executed_step_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["do_steps", "acceptance_criteria", "executed_step_ids"]
    }
  },
  "properties": {
    "run": { "$ref": "#/definitions/run" },
    "task": { "$ref": "#/definitions/task" },
    "step": { "$ref": "#/definitions/step" },
    "paths": { "$ref": "#/definitions/paths" },
    "check_input": { "$ref": "#/definitions/check_input" }
  },
  "required": ["run", "task", "step", "paths", "check_input"]
}
