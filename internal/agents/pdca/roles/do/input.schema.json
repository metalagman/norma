{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoRequest",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "iteration": { "type": "integer" }
      },
      "required": ["id", "iteration"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "goal": { "type": "string" }
      },
      "required": ["id", "goal"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" }
      },
      "required": ["index"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_dir": { "type": "string" }
      },
      "required": ["workspace_dir"]
    },
    "do_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"]
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"]
    },
    "do_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "do_steps": { "type": "array", "items": { "$ref": "#/definitions/do_step" } },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "#/definitions/acceptance_criterion" } }
      },
      "required": ["do_steps", "acceptance_criteria"]
    }
  },
  "properties": {
    "run": { "$ref": "#/definitions/run" },
    "task": { "$ref": "#/definitions/task" },
    "step": { "$ref": "#/definitions/step" },
    "paths": { "$ref": "#/definitions/paths" },
    "do_input": { "$ref": "#/definitions/do_input" }
  },
  "required": ["run", "task", "step", "paths", "do_input"]
}
