{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoResponse",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "do_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executed_step_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["executed_step_ids"]
    }
  },
  "properties": {
    "status": { "type": "string", "enum": ["ok", "stop", "error"] },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "do_output": { "$ref": "#/definitions/do_output" }
  },
  "required": ["status", "summary", "do_output"]
}
