{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActResponse",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "act_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string", "enum": ["close", "replan", "rollback", "continue"] },
        "rationale": { "type": "string" },
        "next": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recommended": { "type": "boolean" },
            "notes": { "type": "string" }
          },
          "required": ["recommended", "notes"]
        }
      },
      "required": ["decision"]
    }
  },
  "properties": {
    "status": { "type": "string", "enum": ["ok", "stop", "error"] },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "act_output": { "$ref": "#/definitions/act_output" }
  },
  "required": ["status", "summary", "act_output"]
}
