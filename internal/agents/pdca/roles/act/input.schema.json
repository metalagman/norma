{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActRequest",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "iteration": { "type": "integer" }
      },
      "required": ["id", "iteration"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "goal": { "type": "string" }
      },
      "required": ["id", "goal"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" }
      },
      "required": ["index"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_dir": { "type": "string" }
      },
      "required": ["workspace_dir"]
    },
    "acceptance_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ac_id": { "type": "string" },
        "result": { "type": "string", "enum": ["PASS", "FAIL"] },
        "notes": { "type": "string" }
      },
      "required": ["ac_id", "result", "notes"]
    },
    "act_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "acceptance_results": {
          "type": "array",
          "items": { "$ref": "#/definitions/acceptance_result" }
        }
      },
      "required": ["verdict"]
    }
  },
  "properties": {
    "run": { "$ref": "#/definitions/run" },
    "task": { "$ref": "#/definitions/task" },
    "step": { "$ref": "#/definitions/step" },
    "paths": { "$ref": "#/definitions/paths" },
    "act_input": { "$ref": "#/definitions/act_input" }
  },
  "required": ["run", "task", "step", "paths", "act_input"]
}
